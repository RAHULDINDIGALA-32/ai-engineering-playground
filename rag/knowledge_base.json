      "category": "leave",
      "subcategory": "paid_leave",
      "title": "Annual Paid Leave",
      "description": "Employees receive 24 days of paid leave per year. Unused paid leave can be carried forward for up to 10 days into the following year.",
      "is_active": true,
      "benefit": {
        "type": "leave_days",
        "amount": 24,
        "unit": "days_per_year"
      },
